# ==============================================================================
# Git Ignore Configuration for SDP (PermRAG)
# ==============================================================================

# Environment and Secrets (CRITICAL: Never commit .env or secret files)
.env
.env.*
!.env.example
*.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Testing and Caches
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
*.log

# Databases and Local Storage
data/*.db
data/*.db-*
data/*.db-shm
data/*.db-wal
data/corpus/
data/qdrant/

# Evaluation Reports and Outputs
evals/reports/

# Temporary and Scratch Files
temp_docx_content.xml
*.tmp

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
