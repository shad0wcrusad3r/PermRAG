# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual keys/settings
# ==============================================================================

# Environment Mode
ENV=dev
SEED=42

# Authentication (Generate a secure 32+ character random secret)
JWT_SECRET=change-me-to-a-secure-32-byte-minimum-secret-key
JWT_EXPIRE_MINUTES=60

# Vector & Relational Stores
QDRANT_URL=http://localhost:16333
SQLITE_URL=sqlite:///./data/permrag.db

# Embeddings Model
EMBED_MODEL=BAAI/bge-small-en-v1.5

# LLM Provider Configuration
# Supported providers: groq, glm, openrouter, ollama, custom
LLM_PROVIDER=groq

# Groq (Free fast inference tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# GLM / Zhipu AI BigModel (glm-4-flash is 100% free: https://open.bigmodel.cn)
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-flash

# OpenRouter Free Models (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Custom OpenAI-Compatible Provider (e.g., SiliconFlow, vLLM, Ollama)
LLM_API_KEY=your_key_here
LLM_BASE_URL=
LLM_MODEL=

# SSL Verification (Set to false if Windows corporate/antivirus/proxy causes untrusted root cert errors)
SSL_VERIFY=false

# Retrieval Hyperparameters
DENSE_TOP_K=30
RERANK_TOP_K=6
MAX_CONTEXT_TOKENS=3000
RERANK_MIN_SCORE=0.0
